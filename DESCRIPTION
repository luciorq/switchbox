Package: switchbox
Title: K-Top-Scoring-Pair (KTSP) Classification
Version: 2.1.0.9001
Authors@R: c(
    person("Bahman", "Afsari", , "bahman@jhu.edu", role = c("aut", "cph")),
    person("Luigi", "Marchionni", , "marchion@jhu.edu", role = c("aut", "cph")),
    person("Wikum", "Dinalankara", , "wdinala1@jhmi.edu", role = c("aut", "cph")),
    person("Lucio", "Rezende Queiroz", , "luciorqueiroz@gmail.com", role = c("aut", "cre"))
